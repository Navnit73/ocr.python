# ==============================================================================
# AI PDF & Image OCR Platform - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Environment
# ------------------------------------------------------------------------------
APP_NAME="AI Document OCR Platform"
APP_ENV="development" # development | staging | production | test
DEBUG=true
API_V1_STR="/api/v1"
PROJECT_VERSION="0.1.0"

# ------------------------------------------------------------------------------
# Server Settings
# ------------------------------------------------------------------------------
SERVER_HOST="0.0.0.0"
SERVER_PORT=8000
SERVER_WORKERS=1
SERVER_RELOAD=true

# ------------------------------------------------------------------------------
# CORS Origins (Comma-separated list or JSON array)
# ------------------------------------------------------------------------------
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000"

# ------------------------------------------------------------------------------
# Security & JWT Authentication
# ------------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY="replace-with-a-very-secure-random-secret-key-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------------------
# MongoDB Configuration (Async via Motor)
# ------------------------------------------------------------------------------
MONGODB_URI="mongodb://localhost:27017"
MONGODB_DB_NAME="ocr_advance_db"
MONGODB_MIN_POOL_SIZE=10
MONGODB_MAX_POOL_SIZE=50
MONGODB_TIMEOUT_MS=5000

# ------------------------------------------------------------------------------
# Redis & Celery Configuration
# ------------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"
CELERY_TASK_DEFAULT_QUEUE="ocr_tasks"
CELERY_TASK_TIME_LIMIT=600

# ------------------------------------------------------------------------------
# Cloudinary File Storage Configuration
# ------------------------------------------------------------------------------
# Storage backend: "cloudinary" for production/cloud or "local" for local filesystem
STORAGE_BACKEND="cloudinary"
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
CLOUDINARY_SECURE=true
CLOUDINARY_FOLDER="ocr_platform"
LOCAL_STORAGE_DIR="./storage_data"

# ------------------------------------------------------------------------------
# File Upload & Validation Settings
# ------------------------------------------------------------------------------
# Max upload size in bytes (default: 25 MB = 26214400)
MAX_FILE_SIZE_BYTES=26214400
ALLOWED_EXTENSIONS="pdf,png,jpg,jpeg,tiff,bmp,webp"
ALLOWED_MIME_TYPES="application/pdf,image/png,image/jpeg,image/tiff,image/bmp,image/webp"
TEMP_FILE_DIR="./temp_uploads"

# ------------------------------------------------------------------------------
# OCR & Document Intelligence Engine Configurations (For Upcoming Phases)
# ------------------------------------------------------------------------------
DEFAULT_OCR_ENGINE="paddleocr" # paddleocr | tesseract
PADDLEOCR_LANG="en"
TESSERACT_CMD_PATH="/usr/bin/tesseract"
DOCLING_ENABLED=true

# ------------------------------------------------------------------------------
# LLM / AI Correction Provider (For Upcoming Phases)
# ------------------------------------------------------------------------------
LLM_PROVIDER="openai" # openai | anthropic | custom
LLM_API_KEY=""
LLM_MODEL_NAME="gpt-4o-mini"
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# ------------------------------------------------------------------------------
# Logging & Monitoring
# ------------------------------------------------------------------------------
LOG_LEVEL="INFO" # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT="json" # json | console
SENTRY_DSN=""
